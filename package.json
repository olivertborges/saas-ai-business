{
  "name": "saas-ai-business",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma SaaS inteligente para pequeños negocios",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
